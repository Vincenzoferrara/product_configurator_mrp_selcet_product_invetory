<odoo>
    <record id="view_product_configurator_wizard_inherit" model="ir.ui.view">
        <field name="name">product.configurator.wizard.inherit</field>
        <field name="model">product.configurator.wizard</field>
        <field name="inherit_id" ref="product_configurator_mrp.view_product_configurator_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="qty_available" string="Quantity Available" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>