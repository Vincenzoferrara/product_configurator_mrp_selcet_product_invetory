<odoo>
    <record id="product_configurator_mrp_select_product_inventory_view" model="ir.ui.view">
        <field name="name">product.configurator.mrp.select.product.inventory.form</field>
        <field name="model">product.configurator.mrp</field>
        <field name="inherit_id" ref="product_configurator_mrp.view_product_configurator_mrp_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Seleziona Prodotto">
                    <group>
                        <field name="product_product_ids" invisible="1"/> <!-- Campo esistente, lo nascondiamo -->
                        <field name="product_id" required="1"/>
                        <field name="qty"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>