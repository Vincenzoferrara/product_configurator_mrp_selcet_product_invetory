<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Prima creiamo la nostra vista per il wizard -->
    <record id="product_configurator_mrp_form_view" model="ir.ui.view">
        <field name="name">product.configurator.mrp.form</field>
        <field name="model">product.configurator.mrp</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="use_inventory_product"/>
                    </group>
                    <notebook attrs="{'invisible': [('use_inventory_product', '=', False)]}">
                        <page string="Seleziona Prodotto dall'Inventario">
                            <group>
                                <field name="inventory_product_id" 
                                       domain="[('type', '=', 'product')]" 
                                       attrs="{'required': [('use_inventory_product', '=', True)]}"
                                       options="{'no_create': True}"/>
                                <field name="quantity" />
                            </group>
                        </page>
                    </notebook>
                    <footer>
                        <button string="Crea Ordine di Produzione" name="create_mrp_production" type="object" class="btn-primary"/>
                        <button string="Annulla" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Registriamo un'azione che apre il nostro wizard -->
    <record id="action_mrp_inventory_product_wizard" model="ir.actions.act_window">
        <field name="name">Crea Ordine di Produzione</field>
        <field name="res_model">product.configurator.mrp</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="product_configurator_mrp_form_view"/>
    </record>
    
    <!-- Aggiungiamo un pulsante al menu che apre il nostro wizard -->
    <menuitem id="menu_mrp_inventory_product"
              name="Crea Prod. da Inventario"
              parent="mrp.menu_mrp_manufacturing"
              action="action_mrp_inventory_product_wizard"
              sequence="5"/>

    <!-- Estensione view dell'ordine di produzione mrp.production -->
    <record id="mrp_production_form_view_inherit" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="use_inventory_product" invisible="1"/>
                <field name="inventory_product_id" 
                       attrs="{'invisible': [('use_inventory_product', '=', False)]}"
                       readonly="True"/>
            </xpath>
        </field>
    </record>
</odoo>