<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Estensione view del wizard product.configurator.mrp -->
    <record id="view_product_configurator_mrp_form_inherit" model="ir.ui.view">
        <field name="name">product.configurator.mrp.form.inherit</field>
        <field name="model">product.configurator.mrp</field>
        <field name="inherit_id" ref="product_configurator_mrp.product_configurator_mrp_form_view"/>
        <field name="arch" type="xml">
            <!-- Aggiungiamo una nuova pagina per la selezione del prodotto dall'inventario -->
            <xpath expr="//form/sheet/group" position="before">
                <div class="alert alert-info" role="alert" attrs="{'invisible': [('use_inventory_product', '=', False)]}">
                    <p><strong>Attenzione:</strong> Se usi un prodotto dall'inventario, la configurazione non sarà applicata.</p>
                </div>
                <group>
                    <field name="use_inventory_product"/>
                </group>
            </xpath>
            <xpath expr="//form/sheet" position="inside">
                <notebook attrs="{'invisible': [('use_inventory_product', '=', False)]}">
                    <page string="Seleziona Prodotto dall'Inventario">
                        <group>
                            <field name="inventory_product_id" 
                                   domain="[('type', '=', 'product')]" 
                                   attrs="{'required': [('use_inventory_product', '=', True)]}"
                                   options="{'no_create': True}"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
    
    <!-- Estensione view dell'ordine di produzione mrp.production -->
    <record id="mrp_production_form_view_inherit" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="use_inventory_product" invisible="1"/>
                <field name="inventory_product_id" 
                       attrs="{'invisible': [('use_inventory_product', '=', False)]}"
                       readonly="True"/>
            </xpath>
        </field>
    </record>
</odoo>