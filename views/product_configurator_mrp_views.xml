<odoo>
    <record id="product_configurator_mrp_select_product_inventory_view" model="ir.ui.view">
        <field name="name">product.configurator.mrp.select.product.inventory.form</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook" position="inside">
                <page string="Seleziona Prodotto">
                    <group>
                        <field name="product_selection_id" context="{'default_production_id': active_id}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="mrp_production_product_selection_form_view" model="ir.ui.view">
        <field name="name">mrp.production.product.selection.form</field>
        <field name="model">mrp.production.product.selection</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="product_id" required="1"/>
                    <field name="qty"/>
                </group>
            </form>
        </field>
    </record>
</odoo>