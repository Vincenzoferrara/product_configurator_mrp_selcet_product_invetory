<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inventory" model="ir.ui.view">
        <field name="name">mrp.production.form.inventory</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_view_inventory_products" type="object" 
                        icon="fa-cubes">
                    <field name="inventory_products_used" invisible="1"/>
                    <field name="inventory_product_ids" widget="statinfo" string="Inventory Products" 
                           attrs="{'invisible': [('inventory_products_used', '=', False)]}"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>