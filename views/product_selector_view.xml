<odoo>
  <record id="view_mrp_config_order_form_selector" model="ir.ui.view">
    <field name="name">mrp.configurator.mrp.form.selector.inherit</field>
    <field name="model">mrp.configurator.mrp</field>
    <field name="inherit_id" ref="product_configurator_mrp.view_mrp_configurator_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet/group" position="inside">
        <group string="Product Selectors">
          <field name="selector_line_ids">
            <tree editable="bottom">
              <field name="category_id"/>
              <field name="product_id"/>
            </tree>
          </field>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
